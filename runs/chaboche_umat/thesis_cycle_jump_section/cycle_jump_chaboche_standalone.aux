\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Per-cycle increment of accumulated viscoplastic strain. After the first cycle, the increment remains nearly constant, supporting the use of a cycle-jump predictor.}}{4}{}\protected@file@percent }
