\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Single-element Abaqus validation model and Chaboche-v1 material-state workflow. The block is a one-element C3D8 specimen with \(L_0=10~\mathrm  {mm}\), a \(2~\mathrm  {mm}\times 2~\mathrm  {mm}\) cross-section, fixed left face, and displacement-controlled cyclic loading on the right face.}}{2}{}\protected@file@percent }
