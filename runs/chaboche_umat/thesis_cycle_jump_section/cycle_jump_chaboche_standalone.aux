\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Amplitude sweep for the Chaboche-v1 UMAT. The smaller amplitudes remain mainly elastic, while the $\pm 0.5\%$ case activates viscoplasticity at a moderate stress level and was selected for the cycle-jump demonstration.}}{3}{}\protected@file@percent }
\newlabel{fig:amplitude_sweep}{{3}{3}{}{figure.3}{}}
