#!/bin/bash
#PBS -N stage16n_r4q3n_exact_native_1cpu
#PBS -q entryq
#PBS -l select=1:ncpus=1:mpiprocs=1:ompthreads=1:mem=30gb
#PBS -l walltime=24:00:00
#PBS -o /scratch/pr21vyci/stage16n_r4q3n_exact_native_control_750_to_1000_1cpu/R4Q3N_exact_native_control_750_to_1000.pbs.out
#PBS -j oe
#PBS -m abe
#PBS -M pr21vyci@mailserver.tu-freiberg.de

set -euo pipefail
# Abaqus marker for guarded wrapper: this PBS stages and runs an Abaqus exact/native diagnostic.

SUBMIT_DIR="${PBS_O_WORKDIR:-$PWD}"
REPO_ROOT="$SUBMIT_DIR"
while [[ "$REPO_ROOT" != "/" && ! -d "$REPO_ROOT/.git" ]]; do
  REPO_ROOT="$(dirname "$REPO_ROOT")"
done
if [[ ! -d "$REPO_ROOT/.git" && -d "/scratch/$USER/git_work/Master_thesis_preparatory/.git" ]]; then
  REPO_ROOT="/scratch/$USER/git_work/Master_thesis_preparatory"
fi
if [[ ! -d "$REPO_ROOT/.git" ]]; then
  echo "Could not resolve Git repository root from PBS_O_WORKDIR=${PBS_O_WORKDIR:-unset}" >&2
  exit 2
fi

export REPO_ROOT
export HOME_CASE_DIR="$REPO_ROOT/runs/chaboche_umat/stage16_abaqus_inhomogeneous_cycle_jump_benchmark/stage16n_restart_control/r4q_long_adaptive_chain_1cpu"
export SUPPORT_CASE_DIR="$REPO_ROOT/runs/chaboche_umat/stage16_abaqus_inhomogeneous_cycle_jump_benchmark/stage16n_restart_control/r4p_boundary_reproducibility_and_diagnostics"
export CONTROLLER="R4Q3N_exact_native_control_750_to_1000"
export SOURCE_CYCLE=750
export SOLVED_START=751
export BLOCK_END=1000
export PREVIOUS_SCRATCH_DIR="/scratch/$USER/stage16n_r4q2_continue_from_cycle500_1cpu/1362597.mmaster02"
export OLDJOB="stage16n_r4q2_block02_500_to_521_solve_522_to_750"
export JOB="stage16n_r4q3n_exact_native_750_to_1000"
export SCRATCH_BASE="/scratch/$USER/stage16n_r4q3n_exact_native_control_750_to_1000_1cpu"
export SCRATCH_CASE_DIR="$SCRATCH_BASE/${PBS_JOBID:-manual}"
export TMPDIR="$SCRATCH_CASE_DIR/tmp"
export LOG_DIR="_logs"
export ABAQUS_CPUS=1
export ABAQUS_MP_MODE=threads
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export MAIL_TO="${MAIL_TO:-${USER}@mailserver.tu-freiberg.de}"
export MAIL_SUBJECT_PREFIX="${MAIL_SUBJECT_PREFIX:-Stage16N-R4Q3N exact/native 750-to-1000}"

mkdir -p "$SCRATCH_BASE" "$SCRATCH_CASE_DIR" "$TMPDIR" "$HOME_CASE_DIR" "$SCRATCH_CASE_DIR/$LOG_DIR"

rsync -a --delete \
  --exclude='*.odb' --exclude='*.stt' --exclude='*.res' --exclude='*.sim' \
  --exclude='*.mdl' --exclude='*.prt' --exclude='*.dat' --exclude='*.msg' \
  --exclude='*.sta' --exclude='*.023' --exclude='*.cax' --exclude='*.abq' \
  --exclude='*.pac' --exclude='*.sel' --exclude='*.lck' --exclude='state.bin' \
  --exclude='state.csv' \
  "$HOME_CASE_DIR/" "$SCRATCH_CASE_DIR/"

for required in \
  stage16n_r3_jump_umat.for \
  stage16n_extract_hysteresis_and_local_states.py \
  stage16n_extract_exact_state_for_reinjection.py \
  stage16n_compare_r3j_jump_against_reference.py; do
  cp "$SUPPORT_CASE_DIR/$required" "$SCRATCH_CASE_DIR/$required"
done

cd "$SCRATCH_CASE_DIR"
exec bash run_stage16n_r4q3n_exact_native_control_750_to_1000_hpc.sh
